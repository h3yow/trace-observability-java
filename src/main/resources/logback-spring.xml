<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 结构化 JSON 日志：一行一个 JSON，携带 traceId/spanId/requestId，便于本地对账 -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="com.github.h3yow.traceobservabilityjava.logging.JsonLogEncoder"/>
    </appender>

    <!-- 同时落盘一份，方便本地用 grep traceId 复盘整条链路 -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/observability.json.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/observability.%d{yyyy-MM-dd}.%i.json.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>3</maxHistory>
        </rollingPolicy>
        <encoder class="com.github.h3yow.traceobservabilityjava.logging.JsonLogEncoder"/>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
    </root>
</configuration>
